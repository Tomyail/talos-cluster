    {
      "id": "claim_c0ebaf31acb54ed7ae9d9c9f602965b2",
      "statement": "Apps consume the shared components by listing repo-relative paths in their Flux Kustomization's spec.components and supplying variables (e.g. APP, VOLSYNC_CAPACITY) via postBuild.substitute; kubernetes/apps/default/gitea/ks.yaml references components/volsync-new and components/gatus/external with APP=gitea and VOLSYNC_CAPACITY=10Gi.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/default/gitea/ks.yaml#L13-L43",
