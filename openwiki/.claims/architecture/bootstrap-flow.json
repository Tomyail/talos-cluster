    {
      "id": "claim_3bd5b2ab2efd413692ead630c8eb72bc",
      "statement": "SOPS secrets applied during bootstrap use sops exec-file to decrypt in-memory and pipe to kubectl apply with --server-side, with decryption using the age recipient age1shkd7fsr66cnpkutpmpf7ffylcc2x4c9tlsdkapv6nmu5ceu0dzqdjtqc5.",
