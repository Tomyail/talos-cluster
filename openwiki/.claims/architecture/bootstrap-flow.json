    {
      "id": "claim_26e652e2472c4b5fbadf74bb58579687",
      "statement": "Because Talos's built-in CNI is disabled in favor of Cilium, nodes remain Ready=False until bootstrap-apps.sh installs Cilium via Helmfile; wait_for_nodes deliberately waits for the Ready=False state and skips only if all nodes are already Ready=True. A Cilium failure (atomic rollback) leaves the cluster unable to progress to Ready=True.",
      "evidence": [
        {
          "resource": "repo://bootstrap/helmfile.yaml#L14-L19",
          "version": "repo-lines-v1:sha256:d99212b8933cd3cd1d6256839d8519a122b64a3b5cf4b5b92d69d16b308d9c05:"
        },
