    {
      "id": "claim_51745d50e12f46d4bc902ca7552e4910",
      "statement": "scripts/bootstrap-apps.sh validates its environment before doing any work: main() calls check_env KUBECONFIG TALOSCONFIG and check_cli helmfile kubectl kustomize sops talhelper yq (helpers from scripts/lib/common.sh), then executes wait_for_nodes, apply_namespaces, apply_sops_secrets, apply_crds, and sync_helm_releases in strict order.",
