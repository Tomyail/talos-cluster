          "version": "repo-lines-v1:sha256:3bfc3f472ae13d3cb7300041bca1ddb97f125a12959972fa488a42b60b9090df:"
        }
      ]
    },
    {
      "id": "claim_f24d6a04ea85495ca9ff037a4dc7bc2b",
      "statement": "Bootstrap ordering forms two dependency chains whose breakage deadlocks the rest: the Helmfile release chain cilium → coredns → cert-manager → flux-operator → flux-instance, and the Flux Kustomization chain cluster-meta → gateway-api-crds/external-dns-crds → cluster-apps (with prune enabled on the CRD Kustomizations).",
      "evidence": [
        {
          "resource": "repo://bootstrap/helmfile.yaml",
