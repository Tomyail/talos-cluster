    {
      "id": "claim_30f820b5ccba4c9a9c4aad7234c3dfc2",
      "statement": "The cluster bootstrap uses a phased approach: `task bootstrap:talos` establishes the Talos Linux control plane via talhelper, `task bootstrap:apps` runs scripts/bootstrap-apps.sh to install critical infrastructure via Helmfile, after which the flux-instance release hands continuous reconciliation off to Flux.",
      "evidence": [
        {
          "resource": "repo://.taskfiles/bootstrap/Taskfile.yaml",
          "version": "repo-file-v1:sha256:3c26042d3a22fc7582ce3641d7090c5346b19f8f4ed41f1d2bf4109072973fa9"
        },
        {
