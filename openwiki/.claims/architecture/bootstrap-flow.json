    {
      "id": "claim_3a9be7730387407eb58c776b4cef2e26",
      "statement": "The apply_crds function installs two CRD sets required by Helm charts: External DNS v0.23.0 standard CRDs and Gateway API v1.6.2 experimental CRDs. Both are also managed by Flux (via GitRepository sources in kubernetes/flux/cluster/ks.yaml) but duplicated for bootstrap safety — notably because Cilium has gatewayAPI enabled and needs the Gateway API CRDs before it starts.",
      "evidence": [
        {
          "resource": "repo://scripts/bootstrap-apps.sh#L88-L118",
          "version": "repo-lines-v1:sha256:dc700e5fd17561d7612c47bc6d91f8fb3022d9913eeca8c99293b5157be38d8c:"
        }
      ]
    },
    {
      "id": "claim_b372cde832a34abba56c97f0a7cc80d3",
      "statement": "Helmfile deploys releases in an atomic needs-chain: Cilium 1.20.2 (CNI, from https://helm.cilium.io) first, then CoreDNS 1.47.1 (needs cilium), then cert-manager v1.21.2 (needs coredns), then flux-operator 0.60.0 (needs cert-manager), and finally flux-instance 0.60.0 (needs flux-operator).",
      "evidence": [
        {
          "resource": "repo://bootstrap/helmfile.yaml#L13-L52",
          "version": "repo-lines-v1:sha256:6476a2b528b6c4c2342d4f5b48106162fde3ac46a5570178b36d8e899f4de7e5:"
        }
      ]
    },
    {
      "id": "claim_413923e9682c40dcbd3013a6d4a993a1",
      "statement": "Helmfile uses cleanupOnFail: true, wait: true, and waitForJobs: true settings to ensure safe deployments with rollback on failure and full readiness before proceeding.",
      "evidence": [
        {
          "resource": "repo://bootstrap/helmfile.yaml#L4-L7",
          "version": "repo-lines-v1:sha256:fee454abfac4ee4f78a0878c19bdd6e58bd1239127092da32b67dbdd1ae5383e:"
        }
      ]
    },
    {
      "id": "claim_9acd43d15210432fadac96054e71b506",
      "statement": "Once flux-instance is deployed by Helmfile, Flux controllers begin reconciling cluster state from the Git repository starting at kubernetes/flux/cluster/ks.yaml, transitioning the cluster to GitOps-managed state.",
