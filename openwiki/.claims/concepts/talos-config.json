    {
      "id": "claim_4127cd77fcc84ba480c92c5910361a25",
      "statement": "Talos configuration is managed through three primary files: talconfig.yaml (cluster topology and node definitions), talenv.yaml (version variables managed by Renovate), and talsecret.sops.yaml (encrypted cluster secrets generated by talhelper gensecret)",
      "evidence": [
        {
          "resource": "repo://talos/talconfig.yaml#L1-L84",
          "version": "repo-lines-v1:sha256:d136b9cff87d6ec237ac03a8d8e93f8f766c991330cacbf3cf6ffd68061bdcde:"
