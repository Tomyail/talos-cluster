    {
      "id": "claim_d2a6b65c808a483c8f9fd2235a8c5845",
      "statement": "`task talos:upgrade-node IP=<ip>` resolves the node's `talosImageURL` from `talconfig.yaml` (selected by `ipAddress` via `yq`) and `talosVersion` from `talenv.yaml`, then runs `talhelper gencommand upgrade` with `--timeout=10m`; the node runs SecureBoot, so its image URL is a `factory.talos.dev/installer-secureboot/<schematic-id>` image.",
      "evidence": [
        {
          "resource": "repo://.taskfiles/talos/Taskfile.yaml#L31-L46",
          "version": "repo-lines-v1:sha256:c7745ffcaf01e49647d3d0c759433bd1c878042e171a2003f9f5ef415c355991:"
