    {
      "id": "claim_eec2edbeca6849a7a1a5a255486e1dc1",
      "statement": "The cluster-apps Kustomization depends on cluster-meta, gateway-api-crds, and external-dns-crds, creating a dependency chain that ensures CRDs are installed before application reconciliation begins.",
