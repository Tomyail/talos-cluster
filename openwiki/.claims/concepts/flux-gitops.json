    {
      "id": "claim_b4514b2489904810aaf304a3b3c32637",
      "statement": "The Flux GitOps architecture implements a four-tier reconciliation hierarchy: cluster-meta (sources and decryption infrastructure), CRD prerequisites (gateway-api, external-dns), cluster-apps (namespace-level Kustomizations), and application Kustomizations (individual workloads).",
      "evidence": [
        {
          "resource": "repo://kubernetes/flux/cluster/ks.yaml#L1-L94",
          "version": "repo-lines-v1:sha256:34d6970a4822f2b762ed2b48b96225a7d9a1bb7f3c4007fed459656c84134c45:"
        },
        {
