    {
      "id": "claim_5e04e393e84a4f95b3ea0abf4c86c091",
      "statement": "The reusable `image-automation` Kustomize component adds three per-app resources — an ExternalSecret for registry credentials from Bitwarden, an ImageRepository scanning every 1m, and an ImagePolicy labeled `image-automation: enabled` that selects the newest timestamp from tags matching `^.+-[a-f0-9]+-(?P<ts>[0-9]+)$` — all parameterized through postBuild substitution variables (APP, NAMESPACE, REGISTRY_URL).",
      "evidence": [
        {
          "resource": "repo://kubernetes/components/image-automation/imagepolicy.yaml#L7-L17",
          "version": "repo-lines-v1:sha256:f87c656d8c2351c4a69bb00481f8c2b1a7827c31822b37c94d824c5b127fa0bd:"
        },
