    {
      "id": "claim_5c46687f304045b989ff75fad46fa484",
      "statement": "Flux decrypts SOPS-encrypted manifests in-cluster using the sops-age Secret, which contains the age.agekey field and is itself SOPS-encrypted in Git. Kustomizations enable decryption via provider: sops and secretRef.name: sops-age.",
