    {
      "id": "claim_05525e8088364f60a29f379875f41360",
      "statement": "Cluster secret verification includes checking the sops-age secret in flux-system namespace, verifying Flux Kustomization decryption configuration, and confirming ExternalSecret synchronization status.",
