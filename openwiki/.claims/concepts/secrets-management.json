        }
      ]
    },
    {
      "id": "claim_cbe8c955753946408926955eb5fe9af7",
      "statement": "The age.key file is stored locally at ./age.key in the repository root, is never committed to Git, and is used by developers for encrypting/decrypting secrets during editing via the SOPS_AGE_KEY_FILE environment variable.",
      "evidence": [
