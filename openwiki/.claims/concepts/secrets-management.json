    {
      "id": "claim_09a9bd3c6a4b4f598f45da6aae2fdd07",
      "statement": "SOPS file verification uses sops --decrypt commands to test encryption validity, with different encrypted_regex patterns for Talos secrets (whole-file) versus Kubernetes secrets (data/stringData fields only).",
      "evidence": [
        {
          "resource": "repo://.sops.yaml",
