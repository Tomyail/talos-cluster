    },
    {
      "id": "claim_8bb96d4389b545ebb16e3a01b5ab5d8c",
      "statement": "ExternalSecrets use the v2 template engine to combine multiple Bitwarden remote refs with static config into one target Secret, commonly also emitting Cloudnative-PG INIT_POSTGRES_* keys so the database operator can bootstrap the app's database; per-entry sourceRef.storeRef allows mixing bitwarden-login and bitwarden-fields in one ExternalSecret (e.g. growth-tracker ASC keys, smtp-relay HOST).",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/default/gitea/app/externalsecret.yaml#L7-L38",
          "version": "repo-lines-v1:sha256:530fec0e92b799e42caf16ed700937cbe65d13773af0dd3e0c46e159d7e61d9a:"
        }
      ]
    },
    {
      "id": "claim_1a3264c8dc3047a4829d5aaaf730cff8",
      "statement": "The 1h interval values on the external-secrets and bitwarden-cli HelmReleases govern Flux chart reconciliation, not ExternalSecret refresh; Bitwarden changes reach synced Secrets only on the operator's refresh interval, and workloads with reloader annotations roll on secret change.",
      "evidence": [
