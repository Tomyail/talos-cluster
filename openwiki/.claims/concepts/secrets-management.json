    },
    {
      "id": "claim_86639b52c2864f3db324ac5c4fb1b432",
      "statement": "The two ClusterSecretStores (bitwarden-login with JSONPath login.<property>, and bitwarden-fields with fields[?(@.name==\"<property>\")].value) are shipped by the bitwarden-eso-provider chart via installCRDs, not defined as repo manifests; bitwarden-fields is required for custom fields since bitwarden-login can only reach login.username/password.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/default/growth-tracker/app/externalsecret.yaml#L60-L95",
          "version": "repo-lines-v1:sha256:37491a8105bf2796c74785ca57a61c2de15ed092b634d61bffb273fa789294c6:"
