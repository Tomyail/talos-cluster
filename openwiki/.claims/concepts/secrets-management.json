    {
      "id": "claim_0815576bdb2a4cdbadeab7cc3f061474",
      "statement": ".sops.yaml defines two creation rules against one shared age recipient: talos/*.sops.yaml files are encrypted as whole files (no encrypted_regex), while (bootstrap|kubernetes)/*.sops.yaml files encrypt only the data/stringData fields via encrypted_regex \"^(data|stringData)$\"; all rules set mac_only_encrypted: true.",
      "evidence": [
        {
          "resource": "repo://.sops.yaml#L2-L9",
          "version": "repo-lines-v1:sha256:a72739e985f90110ea26d10cfc8678b107aba99f7969153054238b16be5f8eb5:"
        }
      ]
    },
    {
      "id": "claim_88bbbb931098456b92e63b06beeffc79",
      "statement": "Bootstrap applies three SOPS-encrypted secrets (github-deploy-key, cluster-secrets, sops-age) into flux-system via `sops exec-file` with kubectl diff idempotency checks, moving the local age key's decryption authority in-cluster before Flux takes over.",
      "evidence": [
        {
          "resource": "repo://scripts/bootstrap-apps.sh#L56-L85",
