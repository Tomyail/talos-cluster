  "claims": [
    {
      "id": "claim_0e4b64aa301a4c2dac2447bb89e242db",
      "statement": "Cilium serves as the cluster's Container Network Interface with eBPF-based data plane, replacing kube-proxy entirely. It operates with Kubernetes-native IPAM, native routing mode for the 10.42.0.0/16 pod network, Maglev load balancing algorithm with Direct Server Return mode, and socket load balancing restricted to host namespace for optimal performance.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/kube-system/cilium/app/helm/values.yaml",
          "version": "repo-file-v1:sha256:a5d44cfd8523a63bed8cf76f09c859c2a9a91a46e254c263386774dccf811abf"
        }
      ]
    },
    {
      "id": "claim_cb5bc10995e74a83831628d2acd9a056",
      "statement": "Cilium implements the Kubernetes Gateway API specification with two gateway instances using the cilium gatewayClass: an external gateway on 192.168.50.13 for public-facing services, and an internal gateway on 192.168.50.12 for cluster-internal services. Both support HTTP (port 80) and HTTPS (port 443) with wildcard hostname matching for *.SECRET_DOMAIN.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/kube-system/cilium/app/helm/values.yaml",
          "version": "repo-file-v1:sha256:a5d44cfd8523a63bed8cf76f09c859c2a9a91a46e254c263386774dccf811abf"
        },
        {
          "resource": "repo://kubernetes/apps/kube-system/cilium/gateway/external.yaml",
          "version": "repo-file-v1:sha256:426b7b64b1da0b8b74c808898ac65e0bd8012c6c6112cb542a5ede5991937bbb"
        },
        {
          "resource": "repo://kubernetes/apps/kube-system/cilium/gateway/internal.yaml",
          "version": "repo-file-v1:sha256:81732658aff94d72a4c861f0feb4d7e41dfb5e62f4d2611e190e4fc328d82ee5"
        }
      ]
    },
    {
      "id": "claim_347a29361b27494ab0b1860c38d89d3a",
      "statement": "Cilium advertises LoadBalancer service IPs via L2 announcements enabled in configuration, providing LoadBalancer functionality in bare-metal environments without cloud provider integration by advertising IPs directly on the local network segment.",
