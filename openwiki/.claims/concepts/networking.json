    {
      "id": "claim_a1f4b291b2864f1b89f1d34e89fd44ee",
      "statement": "External DNS management uses Cloudflare provider with sync policy, watching CRD (DNSEndpoint) and gateway-httproute sources. It creates proxied DNS records for SECRET_DOMAIN with k8s. TXT prefix for ownership verification, targeting the external gateway. Cloudflare API token is stored in cloudflare-dns-secret.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/network/cloudflare-dns/app/helmrelease.yaml",
