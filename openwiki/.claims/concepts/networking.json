    {
      "id": "claim_33fd32bbc9864f099c2cac610da4a58c",
      "statement": "CoreDNS provides standard Kubernetes service discovery with cluster IP 10.43.0.10, running 2 replicas scheduled on control-plane nodes. It includes plugins for errors, health, ready, hosts, kubernetes, autopath, forward, cache, loop, reload, loadbalance, prometheus, and log, with custom host mappings for internal services and upstream forwarding to /etc/resolv.conf.",
