    {
      "id": "claim_accc044028b64880adba64cecc061a17",
      "statement": "Cloudflare Tunnel (cloudflared) provides secure inbound access without opening external ports, running image docker.io/cloudflare/cloudflared:2026.7.3 with HTTP/2 protocol. The tunnel routes traffic for SECRET_DOMAIN and *.SECRET_DOMAIN to the external Cilium Gateway, with the tunnel endpoint registered as a CNAME DNS record pointing to the Cloudflare Tunnel unique ID.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/network/cloudflare-tunnel/app/dnsendpoint.yaml",
