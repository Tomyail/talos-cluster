    {
      "id": "claim_563919815f704fa783a3e1579ad51423",
      "statement": "Every app under kubernetes/apps/<namespace>/<app>/ is defined by a Flux Kustomization in ks.yaml that uses YAML anchors (&app, &namespace) to keep the app name/namespace single-sourced, stamps app.kubernetes.io/name on all built resources via spec.commonMetadata, enables SOPS decryption (provider: sops, secretRef: sops-age), pulls the cluster-secrets Secret via postBuild.substituteFrom, and applies per-app postBuild.substitute variables such as APP and VOLSYNC_CAPACITY with prune: true, wait: true, 1h interval, 2m retryInterval, and 5m timeout.",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L54-L66",
