    {
      "id": "claim_c368688dc28341c08125e3afd80d4101",
      "statement": "The talconfig.yaml file defines the cluster-wide configuration including cluster name (kubernetes), API endpoint using VIP (https://192.168.50.10:6443), pod network (10.42.0.0/16), service network (10.43.0.0/16), and CNI configuration set to none for Cilium integration.",
      "evidence": [
        {
          "resource": "repo://talos/talconfig.yaml",
          "version": "repo-file-v1:sha256:d136b9cff87d6ec237ac03a8d8e93f8f766c991330cacbf3cf6ffd68061bdcde"
        }
      ]
    },
    {
      "id": "claim_baec9810e3da47ab86319944ce3a00d0",
      "statement": "The talenv.yaml file pins Talos and Kubernetes versions using Renovate datasource annotations for automated dependency tracking. It specifies talosVersion and kubernetesVersion which are referenced as variables in talconfig.yaml.",
