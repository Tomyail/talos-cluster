  "claims": [
    {
      "id": "claim_5f6684ab4b77427c8d6232feda00ab34",
      "statement": "The Tailscale operator is deployed via HelmRelease in the network namespace using chart version 1.98.9 from the official Tailscale Helm repository, with hostname 'tailscale', API server proxy enabled, and OAuth credentials injected from a Kubernetes secret.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/network/tailscale/app/helmrelease.yaml#L1-L36",
          "version": "repo-lines-v1:sha256:fe66aca1410c1edacbdd84d47d075eb0ad8cfb56c0ff52f70018fb806e155653:"
        },
        {
          "resource": "repo://kubernetes/flux/meta/repos/tailscale.yaml#L1-L10",
          "version": "repo-lines-v1:sha256:9766eda3cb28b6744d5647bdb154d91c7e258c5ec52b68142b801e724361184c:"
        }
      ]
    },
    {
      "id": "claim_a482c44a7ac8473ca52564911592bd41",
      "statement": "OAuth client credentials for Tailscale authentication are retrieved from Bitwarden via ExternalSecret using the bitwarden-login ClusterSecretStore, mapping username to client_id and password to client_secret from the tailscale_k8s_oauth entry.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/network/tailscale/app/externalsecret.yaml#L1-L28",
          "version": "repo-lines-v1:sha256:6dd6916b243e658d84fe3bcbb80ea0abf4adee8d6c1a71a1588381d06fd96c78:"
        }
      ]
    },
    {
      "id": "claim_22da63fab7a8472d8cc7f0adf5497331",
      "statement": "The Tailscale Kustomization declares dependencies on bitwarden-connect for OAuth credential access and uses SOPS decryption with the sops-age secret to decrypt sensitive values at runtime.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/network/tailscale/ks.yaml#L1-L33",
          "version": "repo-lines-v1:sha256:0d194d9242ae1a0179481ab4a68334d9ab8b513ae362e66e6d5b8c6dbeec1314:"
        }
      ]
    },
    {
      "id": "claim_63741930263a42848733a34f7bbec32a",
      "statement": "The API server proxy is enabled with mode 'true', allowing remote kubectl access to the Kubernetes cluster through the Tailscale network without exposing the API server publicly.",
