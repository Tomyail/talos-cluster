    {
      "id": "claim_43ebca4b18fc4e07ac52a152a135b10b",
      "statement": "Egress proxy services are configured using ExternalName services with tailscale.com/tailnet-ip annotations to route traffic to services in other clusters via their Tailscale IPs, such as the prod-cluster-mosquitto service at 100.123.28.51.",
