    {
      "id": "claim_bece3a87a59c46499e447219c23f9ef7",
      "statement": "Tailscale connectivity is monitored via Gatus with an HTTPS endpoint check using an external DNS resolver (tcp://223.5.5.5:53) at 1-minute intervals to ensure the mesh VPN remains accessible.",
