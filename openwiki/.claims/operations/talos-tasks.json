  "claims": [
    {
      "id": "claim_89e756bd94554d7abb09b1c8a96e73f7",
      "statement": "The Talos operations are defined in `.taskfiles/talos/Taskfile.yaml` with five primary tasks: `generate-config` for regenerating machine configurations, `apply-node` for applying configuration to a single node, `upgrade-node` for Talos OS upgrades, `upgrade-k8s` for Kubernetes upgrades, and `reset` for cluster destruction.",
      "evidence": [
        {
          "resource": "repo://.taskfiles/talos/Taskfile.yaml#L7-L66",
          "version": "repo-lines-v1:sha256:0d17499ac3b179938fa02ec4a0602ca46fa8ce5c2fc9d7422932dc6e229f45e4:"
        }
      ]
    },
    {
      "id": "claim_622679134b28451293af78aed1596dc0",
      "statement": "The `talos:generate-config` task executes `talhelper genconfig` to regenerate machine configurations from `talconfig.yaml`, substituting versions from `talenv.yaml` and applying patches from the patches directory hierarchy.",
      "evidence": [
        {
          "resource": "repo://.taskfiles/talos/Taskfile.yaml#L7-L15",
          "version": "repo-lines-v1:sha256:5db79c470b1c68418177ca82986169ee2ae71e736ae8d5d8740dafbe2ab9dd75:"
