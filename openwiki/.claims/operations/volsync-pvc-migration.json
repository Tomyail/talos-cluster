    {
      "id": "claim_10bc5319a9fa41d8a64686ab50b258ea",
      "statement": "The standard migration flow is: add temporary ReplicationSource, wait for first backup, scale down/suspend HelmRelease, delete old PVC, refactor ks.yaml to the shared component, remove app-local pvc.yaml/volsync.yaml, reconcile Flux, wait for ReplicationDestination restore, then resume and verify — ordering that guarantees a restic backup exists before the live PVC is deleted.",
      "evidence": [
        {
          "resource": "repo://docs/volsync-migration-tracker.md#L16-L28",
          "version": "repo-lines-v1:sha256:d5c10d05c188cbaa32d7c37967c54b266e034e925dab8240d5af80ec0d48659d:"
        }
      ]
    },
