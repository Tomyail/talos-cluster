          "version": "repo-file-v1:sha256:1ef90b64c092bc471e86f997137b0cc8ef881a2326119952d276f99e2fdf30b2"
        }
      ]
    },
    {
      "id": "claim_41bfa264d740432d9ce3ad9e60dd05bf",
      "statement": "TopoLVM uses a single device class named 'thin' that references the lvm_vg volume group and lvm_thin thin pool, with 10 GB spare capacity reserved for metadata and operations. This device class is configured as the default for volume provisioning.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/storage/topolvm/app/helmrelease.yaml#L29-L37",
