    {
      "id": "claim_01d43442d21549de8342cb5b00865c82",
      "statement": "The cluster uses LVM thin provisioning with a volume group (lvm_vg) and thin pool (lvm_thin) configured on /dev/nvme0n1. The thin pool uses 100% of available space with an overprovisioning ratio of 10.0, allowing provisioning up to 10x physical capacity. The setup requires manual formatting documented in lvm-format-manual.yaml before TopoLVM can provision volumes.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/storage/topolvm/app/helmrelease.yaml#L29-L37",
          "version": "repo-lines-v1:sha256:125f52bcbd8466e75571f1e0b0c17fb2330e71f3bb253d4bb318cd0149632278:"
        },
        {
