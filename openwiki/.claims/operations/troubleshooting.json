    {
      "id": "claim_b7cf052bc42640beabcd912c7b688048",
      "statement": "Flux-local CI validates Kubernetes manifests before merge: the test job runs `flux-local test --enable-helm --all-namespaces --sources flux-system --path /github/workspace/kubernetes/flux/cluster -v` (v8.4.0 image), catching syntax errors, invalid manifests, and Helm chart rendering failures.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/flux-local.yaml#L29-L41",
          "version": "repo-lines-v1:sha256:7cae70af74794fcc9fe0b5ae3e85ad53e6981368ad62d71aba1f80603cd628ee:"
