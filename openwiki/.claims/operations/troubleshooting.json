    {
      "id": "claim_793b86e2a246423b8209eec390e0388c",
      "statement": "The qbittorrent egress gateway policy explicitly excludes the API VIP 192.168.50.10/32 to avoid egress self-loops; new egress policies reaching the API or internal endpoints need similar exclusions.",
