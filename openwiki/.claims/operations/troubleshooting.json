        }
      ]
    },
    {
      "id": "claim_bab43805af614dab9ff483229a9ca2fb",
      "statement": "The cluster runs a single-node control plane architecture that introduces specific constraints: Pod anti-affinity rules prevent multi-controller deployments, requiring replicaCount: 1 and affinity overrides for stateful controllers.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/storage/topolvm/app/helmrelease.yaml#L51-L55",
          "version": "repo-lines-v1:sha256:9ffed377a456aa023f103ee11dfad8b1483cd91ca8bdef91a0f9975689ecbec2:"
        }
      ]
    },
    {
      "id": "claim_63c2a38a17a44d209668d447d833113e",
      "statement": "SOPS encryption rules apply different strategies based on file location: talos/.*\\.sops\\.ya?ml files use whole-file encryption, while (bootstrap|kubernetes)/.*\\.sops\\.ya?ml files encrypt only data/stringData fields.",
      "evidence": [
        {
          "resource": "repo://.sops.yaml#L2-L9",
          "version": "repo-lines-v1:sha256:a72739e985f90110ea26d10cfc8678b107aba99f7969153054238b16be5f8eb5:"
        }
