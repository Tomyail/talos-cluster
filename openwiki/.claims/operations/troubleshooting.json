    {
      "id": "claim_3ef8dd539052456b9cfe0a69c25fd163",
      "statement": "SOPS decryption failures occur when the sops-age secret is missing or invalid in the flux-system namespace, preventing Flux from decrypting *.sops.yaml files during reconciliation.",
