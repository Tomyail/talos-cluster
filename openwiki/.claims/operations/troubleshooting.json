          "version": "repo-lines-v1:sha256:9ffed377a456aa023f103ee11dfad8b1483cd91ca8bdef91a0f9975689ecbec2:"
        }
      ]
    },
    {
      "id": "claim_d0aa74e5f90344aab4be4144a639497b",
      "statement": "Flux Kustomizations use a 5-minute timeout with 2-minute retry intervals on failure, and reconciliation failures can be diagnosed using flux logs and status commands.",
