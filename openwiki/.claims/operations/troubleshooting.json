    {
      "id": "claim_71436dcb1c5849e780d5e80fcef39bcb",
      "statement": "Manual intervention for TopoLVM upgrade issues includes deleting pending controller pods or scaling old ReplicaSets to 0 when Helm wait logic becomes stuck.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/storage/topolvm/README.md#L31-L44",
