    {
      "id": "claim_7538b064b2394ff7b45d5aec3f2ce099",
      "statement": "Talos upgrades are automated by tuppr via a TalosUpgrade resource (kube-system) that pins the target Talos version (Renovate-tracked ghcr.io/siderolabs/installer image, e.g. v1.12.7) and uses policy.rebootMode: powercycle, so upgrades powercycle the single node and the API server is unavailable during them.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/kube-system/system-upgrade/upgrades/talos.yaml#L8-L12",
          "version": "repo-lines-v1:sha256:05b40101422d6f3f926c0cd9a9a9f350e3672f4a3bb7ea1832689f003e955612:"
