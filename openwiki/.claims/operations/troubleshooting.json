  "claims": [
    {
      "id": "claim_ff13b80cb8eb45d8b3df24bbc5cfa6f3",
      "statement": "TopoLVM Helm upgrades fail in single-node clusters when the chart defaults (replicaCount: 2 with required anti-affinity rules) prevent new controller pods from scheduling during rolling updates, causing Helm wait logic to timeout.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/storage/topolvm/README.md#L5-L15",
          "version": "repo-lines-v1:sha256:7ea8d6747789db2d7cafd232a1c609e16fd95ddccc883cbcc972cf9037419b39:"
        },
        {
          "resource": "repo://kubernetes/apps/storage/topolvm/app/helmrelease.yaml#L51-L55",
          "version": "repo-lines-v1:sha256:9ffed377a456aa023f103ee11dfad8b1483cd91ca8bdef91a0f9975689ecbec2:"
        }
      ]
    },
    {
      "id": "claim_d6f99209e7bf414ab5dc759a04ad5c5c",
      "statement": "The TopoLVM single-node upgrade fix requires three configuration overrides: setting replicaCount: 1, disabling affinity rules (affinity: \"\"), and using Recreate update strategy to prevent scheduling conflicts.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/storage/topolvm/README.md#L19-L28",
          "version": "repo-lines-v1:sha256:c619d1f8881831af8180bd51069e3ec778937047bebd7b8eb44ecd155358cd9a:"
