    {
      "id": "claim_0c54c76c766042a89096a631c8959a53",
      "statement": "Automated Talos and Kubernetes upgrades run via tuppr (system-upgrade controller) with TalosUpgrade/KubernetesUpgrade resources under kubernetes/apps/kube-system/system-upgrade, monitored by Prometheus rules alerting on failed upgrade phases.",
      "evidence": [
