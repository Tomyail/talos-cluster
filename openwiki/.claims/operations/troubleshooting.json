        }
      ]
    },
    {
      "id": "claim_75089d130e244e33ac8144108e280ae4",
      "statement": "VolSync backup repository secrets are generated by ExternalSecrets from the bitwarden-login ClusterSecretStore, templating RESTIC_REPOSITORY, RESTIC_PASSWORD and MinIO AWS credentials from the volsync-minio-template and cold-minio Bitwarden entries — so missing/empty backup secrets usually indicate an external-secrets sync failure rather than a VolSync problem.",
      "evidence": [
