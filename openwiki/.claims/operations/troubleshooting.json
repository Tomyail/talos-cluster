    {
      "id": "claim_188cccd90c90437d9c76b91b5d823e49",
      "statement": "All flux-local CI validation is gated by a pre-job changed-files check on `kubernetes/**`: when no Kubernetes files changed in a PR, the test and diff jobs are skipped, and the final flux-local-status job passes on skipped jobs, so only real failures block merge.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/flux-local.yaml#L14-L33",
          "version": "repo-lines-v1:sha256:66cb60500102eb82bd1424dc25d08d83b7ccec9961a9ea3ae846f738cc3a07cb:"
        }
      ]
    },
    {
      "id": "claim_76aa41f5d14641fb9c531bfc37f49af9",
      "statement": "The flux-local diff job runs a matrix over helmrelease and kustomization resources, diffs the PR branch against the default branch with noise-stripping attributes (helm.sh/chart, checksum/config, app.kubernetes.io/version, chart), and posts the resulting patch as a PR comment; the comment step has continue-on-error so a failed comment does not fail the job.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/flux-local.yaml#L43-L108",
          "version": "repo-lines-v1:sha256:026f732d4e902e00fd49197a0a9b2dd654ade61033768d77608b7eade7dd2430:"
        }
      ]
    },
    {
      "id": "claim_dc794add0497416e88b08b040fbbebae",
      "statement": "Single-node Talos upgrades are performed via `task talos:upgrade-node IP=<node-ip>`, which resolves the image URL and Talos version from talconfig/talenv via talhelper and runs `talhelper gencommand upgrade`.",
