    {
      "id": "claim_b430165782d943f3a7ba2cba1c3afa5e",
      "statement": "The tuppr-upgrades Kustomization (path kubernetes/apps/kube-system/system-upgrade/upgrades) depends on the tuppr controller Kustomization, both in kube-system with 30m interval and 5m timeout.",
      "evidence": [
