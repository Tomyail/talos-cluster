    {
      "id": "claim_07593d75fef64a4f8c3bbb9ff3a3605c",
      "statement": "Application data is backed up with VolSync restic ReplicationSource resources pushing to a MinIO S3 endpoint (s3:http://192.168.50.220:9010/volsync/...), scheduled every 6 hours, with hourly/daily/weekly retention, a 7-day prune interval, and a 2Gi local-path mover cache; this pattern is used for nextcloud and calibre-web-automated.",
      "evidence": [
        {
          "resource": "repo://kubernetes/apps/default/calibre-web-automated/app/volsync-nfs.yaml#L36-L36",
          "version": "repo-lines-v1:sha256:c61400eff7b07c6e49495ae55428cda186fbe905fda2332b5dc7e451d4b412e2:"
