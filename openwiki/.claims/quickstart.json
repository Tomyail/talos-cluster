    {
      "id": "claim_7007b04a9365408685923e5725757fbe",
      "statement": "The cluster architecture consists of four layers: Infrastructure (Talos Linux nodes on bare-metal hardware), Platform (Kubernetes v1.35.4 with Cilium CNI and TopoLVM storage), GitOps (Flux operator managing Helm releases from Git repository), and Services (Networking via Cloudflare Tunnel/Tailscale, Observability stack, and 30+ applications).",
      "evidence": [
        {
          "resource": "repo://README.md#L22-L29",
          "version": "repo-lines-v1:sha256:83b1495230a418c8a5e1f171efbb502a0344da14b6a54b3e430cefd2205adffc:"
