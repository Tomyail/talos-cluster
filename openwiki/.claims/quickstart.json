    {
      "id": "claim_f24a49fe9d544d798a8fe82969596217",
      "statement": "The standard end-to-end change loop is: edit manifests under kubernetes/apps/<namespace>/<app>/, verify with kustomize build (optionally kubeconform), commit to main, optionally force sync with `task reconcile` (flux reconcile kustomization flux-system --with-source), then verify via `flux get kustomizations -A`, Kustomization status conditions, `flux get helmreleases`, and pod health; Flux prunes removed resources because prune: true is set on the root and app Kustomizations, so reverting a commit rolls back state.",
      "evidence": [
        {
          "resource": "repo://Taskfile.yaml#L30-L35",
          "version": "repo-lines-v1:sha256:2d7afb436ef2bf4a0fd148c2805957c35d446a460ca2d84fcbf88bb511ba7c0f:"
