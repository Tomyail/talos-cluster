// Git-owned and read-only. Agent identities, model routing, and workspaces are policy.
{
  ownership: "explicit",
  defaults: {
    model: {
      primary: "magpie/group/default",
    },
    modelPolicy: {
      allow: [
        "magpie/group/default",
      ],
    },
    workspace: "/home/node/.openclaw/workspace",
    compaction: {
      mode: "safeguard",
    },
    elevatedDefault: "full",
    systemAgent: {
      agentId: "main",
    },
    heartbeat: {
      agentId: "main",
    },
  },
  entries: {
    main: {
    },
  },
}
